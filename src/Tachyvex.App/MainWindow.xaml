<Window
    x:Class="Tachyvex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tachyvex.App"
    Title="NEOX">
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <!-- Animowana aurora w tle -->
        <Grid IsHitTestVisible="False">
            <Image x:Name="Aurora1" Source="ms-appx:///Assets/glow-cyan.png" Width="900" Height="900" Opacity="0.30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-320,0,0" />
            <Image x:Name="Aurora2" Source="ms-appx:///Assets/glow-blue.png" Width="900" Height="900" Opacity="0.28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-320,-380" />
            <Image x:Name="Aurora3" Source="ms-appx:///Assets/glow-navy.png" Width="900" Height="900" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="240,40,0,0" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/neox-logo.png" Width="20" Height="20" />
                    <TextBlock Text="NEOX" FontWeight="Bold" CharacterSpacing="160" FontSize="12" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="AdminBar" Grid.Row="1" Severity="Warning" IsOpen="False" IsClosable="False" Margin="16,0,16,8"
                     Title="Standard mode"
                     Message="Some optimizations (services, bcdedit, network adapters, HKLM) need administrator rights. NEOX asks for them only when you ask for it.">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" Click="OnRestartAsAdmin" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="UpdateBar" Grid.Row="2" Severity="Informational" IsOpen="False" IsClosable="True" Margin="16,0,16,8" Title="Update" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Menu boczne: szkło + poświata -->
                <Border Grid.Column="0" Margin="14,4,0,14" CornerRadius="22" Background="#B3070B16" BorderThickness="1" BorderBrush="#2222D3EE">
                    <Grid Padding="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,2,0,18">
                            <Grid Width="46" Height="46">
                                <Ellipse x:Name="LogoGlow" Fill="{StaticResource AccentBrush}" Opacity="0.35" Margin="-6" />
                                <Image Source="ms-appx:///Assets/neox-logo.png" Width="46" Height="46" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NEOX" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="Bold" CharacterSpacing="180" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="NavHost" Grid.Row="1">
                            <Border x:Name="NavIndicator" Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{StaticResource AccentGradientBrush}" Margin="-12,0,0,0" Opacity="0" />
                            <ListView x:Name="NavList" SelectionMode="Single" ItemContainerStyle="{StaticResource NavItemStyle}"
                                      SelectionChanged="OnNavSelectionChanged" IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:NavItem">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="by spinprint" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Column="1" Margin="0" />
            </Grid>
        </Grid>

        <!-- INTRO -->
        <Grid x:Name="Splash" Background="#FF05070D" Tapped="OnSplashTapped">
            <Image x:Name="SplashGlow" Source="ms-appx:///Assets/glow-cyan.png" Width="900" Height="900" Opacity="0" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <Grid Width="160" Height="160" HorizontalAlignment="Center">
                    <Ellipse x:Name="SplashWave1" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0" />
                    <Ellipse x:Name="SplashWave2" Stroke="{StaticResource GoodBrush}" StrokeThickness="1.5" Opacity="0" />
                    <Image x:Name="SplashLogo" Source="ms-appx:///Assets/neox-logo.png" Width="120" Height="120" Opacity="0" />
                </Grid>
                <TextBlock x:Name="SplashTitle" Text="NEOX" FontFamily="Segoe UI Variable Display" FontSize="42" FontWeight="Bold" CharacterSpacing="500" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Opacity="0" />
                <TextBlock x:Name="SplashTag" Text="OPTIMIZATION WITHOUT GUESSWORK" FontSize="11" CharacterSpacing="320" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Opacity="0" />
                <ProgressBar x:Name="SplashBar" Width="240" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
