<Window
    x:Class="Tachyvex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NEOX">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentGradientBrush}" />
                <TextBlock Text="NEOX" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminBar" Grid.Row="1" Severity="Warning" IsOpen="False" IsClosable="False" Margin="12,0,12,8"
                 Title="Tryb standardowy"
                 Message="Część optymalizacji (usługi, bcdedit, karty sieciowe, HKLM) wymaga administratora. Program prosi o uprawnienia tylko na Twoje żądanie.">
            <InfoBar.ActionButton>
                <Button Content="Uruchom ponownie jako administrator" Click="OnRestartAsAdmin" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar x:Name="UpdateBar" Grid.Row="2" Severity="Informational" IsOpen="False" IsClosable="True" Margin="12,0,12,8" Title="Aktualizacja" />

        <NavigationView x:Name="Nav" Grid.Row="3" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        OpenPaneLength="220" SelectionChanged="OnSelectionChanged" Background="Transparent">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,6,0,14">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="N" FontSize="20" FontWeight="Black" Foreground="#021018" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEOX" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="Auto-Tune" Tag="autotune">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gaming i profile" Tag="gaming" Icon="Play" />
                <NavigationViewItem Content="Optymalizacje" Tag="optimizations" Icon="Admin" />
                <NavigationViewItem Content="Sieć" Tag="network" Icon="World" />
                <NavigationViewItem Content="System" Tag="system" Icon="Setting" />
                <NavigationViewItem Content="Start, procesy, usługi" Tag="managers" Icon="List" />
                <NavigationViewItem Content="Dysk" Tag="disk" Icon="Library" />
                <NavigationViewItem Content="Historia i przywracanie" Tag="history" Icon="Undo" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ustawienia" Tag="settings" Icon="Edit" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Margin="0,0,0,0" />
        </NavigationView>

        <!-- INTRO -->
        <Grid x:Name="Splash" Grid.RowSpan="4" Background="#FF05070D" Tapped="OnSplashTapped">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <Ellipse x:Name="SplashWave1" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0" />
                    <Ellipse x:Name="SplashWave2" Stroke="{StaticResource GoodBrush}" StrokeThickness="1.5" Opacity="0" />
                    <Border x:Name="SplashLogo" Width="84" Height="84" CornerRadius="24" Background="{StaticResource AccentGradientBrush}" Opacity="0">
                        <TextBlock Text="N" FontSize="52" FontWeight="Black" Foreground="#021018" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock x:Name="SplashTitle" Text="NEOX" FontSize="38" FontWeight="Bold" CharacterSpacing="450" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Opacity="0" />
                <TextBlock x:Name="SplashTag" Text="OPTYMALIZACJA BEZ ZGADYWANIA" FontSize="11" CharacterSpacing="300" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Opacity="0" />
                <ProgressBar x:Name="SplashBar" Width="220" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
