<Window
    x:Class="Tachyvex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TACHYVEX">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentGradientBrush}" />
                <TextBlock Text="TACHYVEX" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminBar" Grid.Row="1" Severity="Warning" IsOpen="False" IsClosable="False" Margin="12,0,12,8"
                 Title="Tryb standardowy"
                 Message="Część optymalizacji (usługi, bcdedit, karty sieciowe, HKLM) wymaga administratora. Program prosi o uprawnienia tylko na Twoje żądanie.">
            <InfoBar.ActionButton>
                <Button Content="Uruchom ponownie jako administrator" Click="OnRestartAsAdmin" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar x:Name="UpdateBar" Grid.Row="2" Severity="Informational" IsOpen="False" IsClosable="True" Margin="12,0,12,8" Title="Aktualizacja" />

        <NavigationView x:Name="Nav" Grid.Row="3" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        OpenPaneLength="220" SelectionChanged="OnSelectionChanged" Background="Transparent">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,6,0,14">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="T" FontSize="20" FontWeight="Black" Foreground="#021018" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TACHYVEX" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="Gaming i profile" Tag="gaming" Icon="Play" />
                <NavigationViewItem Content="Optymalizacje" Tag="optimizations" Icon="Admin" />
                <NavigationViewItem Content="Sieć" Tag="network" Icon="World" />
                <NavigationViewItem Content="System" Tag="system" Icon="Setting" />
                <NavigationViewItem Content="Start, procesy, usługi" Tag="managers" Icon="List" />
                <NavigationViewItem Content="Dysk" Tag="disk" Icon="Library" />
                <NavigationViewItem Content="Historia i przywracanie" Tag="history" Icon="Undo" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ustawienia" Tag="settings" Icon="Edit" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Margin="0,0,0,0" />
        </NavigationView>
    </Grid>
</Window>
