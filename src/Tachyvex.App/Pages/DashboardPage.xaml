<Page x:Class="Tachyvex.App.Pages.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Panel" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Stan komputera na żywo. Pomiary działają tylko, gdy ta strona jest otwarta." Style="{StaticResource MutedTextStyle}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Cpu, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RAM" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Ram, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU (3D)" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GpuText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Gpu, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Komputer" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Hardware, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.Health, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Profile jednym kliknięciem" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Przed zastosowaniem zobaczysz listę zmian. Każda zmiana ma kopię zapasową i da się ją cofnąć." Style="{StaticResource MutedTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Profile">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Zastosuj" Style="{StaticResource AccentButtonStyleX}"
                                            Click="OnApplyProfile" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Utwórz punkt przywracania" Command="{x:Bind ViewModel.RestorePointCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
