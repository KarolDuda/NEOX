<Page x:Class="Tachyvex.App.Pages.AutoTunePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Tachyvex.App.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="28,8,28,28" Spacing="16">
                <Border x:Name="Hero" CornerRadius="18" Padding="30" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0C2038" Offset="0" />
                            <GradientStop Color="#0A1226" Offset="0.55" />
                            <GradientStop Color="#06121F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <TextBlock Text="AUTO-TUNE" FontSize="12" CharacterSpacing="250" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="We tune NEOX to your hardware" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HardwareText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <ToggleSwitch Header="Measure before and after (honest comparison with a noise threshold)" IsOn="{x:Bind ViewModel.Measure, Mode=TwoWay}" OnContent="Yes" OffContent="No" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                            <Grid>
                                <Border x:Name="RunGlow" CornerRadius="14" Background="{StaticResource AccentGradientBrush}" Margin="-6" Opacity="0.3" IsHitTestVisible="False" />
                                <Button Command="{x:Bind ViewModel.RunCommand}" IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" Style="{StaticResource AccentButtonStyleX}" Padding="30,14" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE945;" FontSize="18" />
                                        <TextBlock Text="RUN AUTO-TUNE" FontSize="16" FontWeight="Bold" CharacterSpacing="100" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource GhostButtonStyle}" IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="26" Height="26" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ReportCard" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ReportVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid Width="44" Height="44">
                                <Ellipse x:Name="Wave" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0" />
                                <Ellipse Fill="#1A22D3EE" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                <FontIcon x:Name="Check" Glyph="&#xE73E;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Deltas}" Visibility="{x:Bind ViewModel.DeltasVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeltaRow">
                                    <Grid Margin="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Mark}" Foreground="{StaticResource AccentBrush}" FontSize="16" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind Verdict}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Change}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Right">
                                                <Run Text="{x:Bind Before}" /><Run Text=" → " /><Run Text="{x:Bind After}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <Button Content="Undo everything from Auto-Tune" Command="{x:Bind ViewModel.UndoCommand}" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="PlanCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Your plan" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Planned}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlanRow">
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Title}" />
                                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
