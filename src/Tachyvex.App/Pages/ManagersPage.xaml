<Page x:Class="Tachyvex.App.Pages.ManagersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Startup, processes &amp; services" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Programs that start with Windows" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="The switch disables or enables an entry just like Task Manager; nothing is deleted." Style="{StaticResource MutedTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Startup}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupItemViewModel">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="" OffContent="" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Processes (highest memory use)" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Memory}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Cpu}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Pid}" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Windows services" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StartType}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Note}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
