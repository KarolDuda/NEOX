<Page x:Class="Tachyvex.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Ustawienia" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AdminStatus}" />
                    <ToggleSwitch Header="Punkt przywracania przed zastosowaniem profilu (gdy dostępny)" IsOn="{x:Bind ViewModel.RestorePointBeforeProfiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Aktualizuj automatycznie (sprawdzanie przy starcie, ciche pobranie i instalacja)" IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Sprawdź aktualizacje" Command="{x:Bind ViewModel.CheckUpdateCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.UpdateBusy, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="Otwórz folder danych i logów" Command="{x:Bind ViewModel.OpenDataFolderCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.LogPath}" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Zasady bezpieczeństwa" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="• Program nie wyłącza Windows Defendera ani Windows Update.&#x0a;• Każda zmiana ma kopię zapasową stanu sprzed zmiany i da się ją cofnąć.&#x0a;• Zmiany wysokiego ryzyka i eksperymentalne wymagają osobnego potwierdzenia.&#x0a;• Zmiana jest weryfikowana odczytem; jeśli system jej nie przyjął, poprzedni stan jest przywracany.&#x0a;• Etykiety efektu ze starej wersji nie są prezentowane jako pomiar, a program nie obiecuje wzrostu FPS." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="O programie" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="TACHYVEX" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Autor i wydawca: spinprint" />
                    <HyperlinkButton Content="spinprint.pl" NavigateUri="https://spinprint.pl" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
