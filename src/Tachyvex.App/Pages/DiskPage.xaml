<Page x:Class="Tachyvex.App.Pages.DiskPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Dysk" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Analiza zajętości" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox ItemsSource="{x:Bind ViewModel.Drives}" SelectedIndex="{x:Bind ViewModel.DriveIndex, Mode=TwoWay}" MinWidth="120" />
                        <Button Content="Analizuj" Command="{x:Bind ViewModel.AnalyzeCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <Button Content="Przerwij" Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Size}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="Czyszczenie plików tymczasowych, cache i dzienników: zakładka Optymalizacje → kategoria Czyszczenie." Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
