<Page x:Class="Tachyvex.App.Pages.SystemPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="System" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="4"><TextBlock Text="Processor" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.Cpu, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="4"><TextBlock Text="Graphics card" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.Gpu, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="4"><TextBlock Text="Memory (RAM)" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.Ram, Mode=OneWay}" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="4"><TextBlock Text="Windows" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.Os, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Disks" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Disks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Volumes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Style="{StaticResource MutedTextStyle}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
