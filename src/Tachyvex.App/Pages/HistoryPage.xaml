<Page x:Class="Tachyvex.App.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Historia i przywracanie" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Przywracanie" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Applied, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Cofnij wszystkie zmiany NEOX" Command="{x:Bind ViewModel.RevertAllCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Porównanie przed / po" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Zapisz konfigurację przed zmianami, a potem porównaj ją ze stanem bieżącym. To porównanie ustawień, nie pomiar wydajności." Style="{StaticResource MutedTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Zapisz bieżącą konfigurację" Command="{x:Bind ViewModel.CaptureBaselineCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Baselines, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.BaselineIndex, Mode=TwoWay}" MinWidth="260" PlaceholderText="Wybierz zapisaną konfigurację" />
                        <Button Content="Porównaj z bieżącą" Command="{x:Bind ViewModel.CompareCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Diff}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Before}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Now}" Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Dziennik zmian" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRow">
                                <Grid ColumnSpacing="12" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Action}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Result}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
