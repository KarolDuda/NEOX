<ResourceDictionary
    x:Class="Tachyvex.App.Styles.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tachyvex.App.ViewModels">

    <DataTemplate x:Key="TweakTemplate" x:DataType="vm:TweakItemViewModel">
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind RiskText}" Foreground="{x:Bind RiskBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{x:Bind Consequences}" Visibility="{x:Bind ConsequencesVisibility}" Style="{StaticResource MutedTextStyle}" FontSize="12" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind AdminText}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind RestartText}" Foreground="{StaticResource WarnBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <Button Content="{x:Bind ActionText, Mode=OneWay}" Command="{x:Bind PrimaryCommand}" MinWidth="110"
                            IsEnabled="{x:Bind IsIdle, Mode=OneWay}" Style="{StaticResource GhostButtonStyle}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
