<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgDeep">#05070D</Color>
    <Color x:Key="BgNavy">#0A1226</Color>
    <Color x:Key="CardColor">#D90E1627</Color>
    <Color x:Key="CardBorderColor">#2A2F4A6B</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentDeepColor">#0EA5E9</Color>

    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6ECF8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A97B5" />
    <SolidColorBrush x:Key="GoodBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="BadBrush" Color="#F87171" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BgDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BgNavy}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentDeepColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,6" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AccentButtonStyleX" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="#021018" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#2222D3EE" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <LinearGradientBrush x:Key="NavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3322D3EE" Offset="0" />
        <GradientStop Color="#0A22D3EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Pozycja menu bocznego: szklana, z poświatą przy zaznaczeniu -->
    <Style x:Key="NavItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        CornerRadius="14" Padding="14,0"
                        SelectionIndicatorVisualEnabled="False"
                        SelectedBackground="{StaticResource NavSelectedBrush}"
                        SelectedPointerOverBackground="{StaticResource NavSelectedBrush}"
                        SelectedPressedBackground="{StaticResource NavSelectedBrush}"
                        PointerOverBackground="#14FFFFFF"
                        PressedBackground="#1EFFFFFF"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel boczny i tło treści -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#CC070B16" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#CC070B16" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1822D3EE" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#22D3EE" />
</ResourceDictionary>
