<Page x:Class="Neox.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="using:Neox.Core.State"
      xmlns:vm="using:Neox.App.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel x:Name="Content" Padding="28,8,28,28" Spacing="18">

                <!-- HERO -->
                <Border x:Name="Hero" CornerRadius="18" Padding="30" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0C2038" Offset="0" />
                            <GradientStop Color="#0A1226" Offset="0.55" />
                            <GradientStop Color="#06121F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="READY TO PLAY?" FontSize="12" CharacterSpacing="250" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="One-click optimization" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" MaxWidth="560"
                                       Text="Applies the safe Gaming profile. You see the list of changes before anything happens, and every change can be undone in History." />
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                                <Grid>
                                    <Border x:Name="BoostGlow" CornerRadius="14" Background="{StaticResource AccentGradientBrush}" Margin="-6" Opacity="0.3" IsHitTestVisible="False" />
                                    <Button x:Name="BoostButton" Command="{x:Bind ViewModel.BoostCommand}" Style="{StaticResource AccentButtonStyleX}"
                                            Padding="30,14" CornerRadius="12" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE945;" FontSize="18" />
                                            <TextBlock Text="OPTIMIZE" FontSize="16" FontWeight="Bold" CharacterSpacing="100" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button Content="Auto-Tune" Click="OnGoAutoTune" Style="{StaticResource GhostButtonStyle}" Padding="22,14" CornerRadius="12" VerticalAlignment="Center" />
                                <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="26" Height="26" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="150">
                            <TextBlock Text="{x:Bind ViewModel.AppliedCount, Mode=OneWay}" FontSize="64" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="active changes" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WSKAŹNIKI -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CardCpu" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Cpu, Mode=OneWay}" Width="96" Height="96" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="CPU" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="processor load" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CardRam" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Ram, Mode=OneWay}" Width="96" Height="96" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RamPct, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="RAM" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CardGpu" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Gpu, Mode=OneWay}" Width="96" Height="96" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.GpuPct, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="GPU (3D)" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.GpuText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ZDROWIE SYSTEMU -->
                <Border x:Name="CardHealth" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <Grid Width="150" Height="150">
                                <ProgressRing x:Name="ScoreRing" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Width="150" Height="150" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ScoreText" Text="0" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="/ 100" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.HealthLabel, Mode=OneWay}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="System health" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="The score comes from transparent rules: disk space, restart, startup apps, applied optimizations and RAM." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HealthChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HealthRow">
                                        <Grid Margin="0,4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Mark}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{x:Bind FixText}" Visibility="{x:Bind FixVisibility}" Style="{StaticResource AccentButtonStyleX}" Click="OnFix" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KOMPUTER -->
                <Border x:Name="CardHw" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Your PC" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Hardware, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Health, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- PROFILE -->
                <TextBlock Text="Profiles" Style="{StaticResource SectionTitleStyle}" Margin="2,6,0,0" />
                <GridView ItemsSource="{x:Bind ViewModel.Profiles}" SelectionMode="None" IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="core:Profile">
                            <Border Style="{StaticResource CardStyle}" Width="330" Height="170">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Row="2" Content="Apply profile" Style="{StaticResource AccentButtonStyleX}" Click="OnApplyProfile" Tag="{x:Bind}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Create restore point" Command="{x:Bind ViewModel.RestorePointCommand}" Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- NAKŁADKA SUKCESU -->
        <Grid x:Name="Overlay" Visibility="Collapsed" Background="#D9040810">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                    <Ellipse x:Name="Wave1" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Opacity="0" />
                    <Ellipse x:Name="Wave2" Stroke="{StaticResource GoodBrush}" StrokeThickness="2" Opacity="0" />
                    <Ellipse Width="110" Height="110" Fill="#1A22D3EE" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    <FontIcon x:Name="BigCheck" Glyph="&#xE73E;" FontSize="54" Foreground="{StaticResource AccentBrush}" Opacity="0" />
                </Grid>
                <TextBlock x:Name="OverlayTitle" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayText" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" />
                <Button Content="Great" Style="{StaticResource AccentButtonStyleX}" HorizontalAlignment="Center" Click="OnCloseOverlay" Padding="34,10" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
