<Page x:Class="Neox.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Neox.App.ViewModels" xmlns:core="using:Neox.Core.State" xmlns:tw="using:Neox.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AdminStatus}" />
                    <ToggleSwitch Header="Create a restore point before applying a profile (when available)" IsOn="{x:Bind ViewModel.RestorePointBeforeProfiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Update automatically (check on launch, silent download and install)" IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckUpdateCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.UpdateBusy, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="Open data and logs folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.LogPath}" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Safety rules" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="• NEOX never disables Windows Defender or Windows Update.&#x0a;• Every change keeps a backup of the previous state and can be undone.&#x0a;• High-risk and experimental changes need separate confirmation.&#x0a;• Each change is verified by read-back; if Windows rejects it, the previous state is restored.&#x0a;• NEOX does not promise FPS gains and does not present effects it has not measured." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="NEOX" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Author and publisher: spinprint" />
                    <HyperlinkButton Content="spinprint.pl" NavigateUri="https://spinprint.pl" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
