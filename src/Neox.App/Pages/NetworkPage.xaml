<Page x:Class="Neox.App.Pages.NetworkPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Neox.App.ViewModels" xmlns:core="using:Neox.Core.State" xmlns:tw="using:Neox.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Network" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Adapters and connection" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Adapters}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ping test" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Custom host or IP (optional)" Text="{x:Bind ViewModel.CustomHost, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Test" Command="{x:Bind ViewModel.PingAllCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PingRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PingRow">
                                <Grid ColumnSpacing="12" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Summary}" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="DNS servers" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="The test measures response time on your connection. Changing DNS requires administrator rights; previous settings are saved and can be restored." Style="{StaticResource MutedTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Test DNS servers" Command="{x:Bind ViewModel.BenchDnsCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <Button Content="Use the fastest" Command="{x:Bind ViewModel.UseBestDnsCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Restore previous DNS" Command="{x:Bind ViewModel.RestoreDnsCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.BestDns, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DnsRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DnsRow">
                                <Grid ColumnSpacing="12" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Servers}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Result}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="MTU" Style="{StaticResource SectionTitleStyle}" />
                    <Button Content="Find MTU" Command="{x:Bind ViewModel.FindMtuCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.MtuText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="More safe network settings (Nagle, ACK, adapters) are in Optimizations → Network." Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
