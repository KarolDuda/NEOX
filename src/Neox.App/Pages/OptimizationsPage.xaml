<Page x:Class="Neox.App.Pages.OptimizationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Neox.App.ViewModels" xmlns:core="using:Neox.Core.State" xmlns:tw="using:Neox.Windows">
    <Grid Padding="28,8,28,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Optimizations" Style="{StaticResource PageTitleStyle}" />
            <Border CornerRadius="14" Padding="12,4" Background="#1822D3EE" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="13" Text="{x:Bind ViewModel.AppliedCount, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="13" Text="applied" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search settings (name, description)…" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Categories}" SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Risks}" SelectedIndex="{x:Bind ViewModel.RiskIndex, Mode=TwoWay}" />
            <Button Grid.Column="3" Content="Refresh states" Command="{x:Bind ViewModel.RefreshStatesCommand}" Style="{StaticResource GhostButtonStyle}" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.Counter, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" Width="18" Height="18" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="False"
                  ItemTemplate="{StaticResource TweakTemplate}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
