<Page x:Class="Tachyvex.App.Pages.NetworkPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Tachyvex.App.ViewModels" xmlns:core="using:Tachyvex.Core.State" xmlns:tw="using:Tachyvex.Windows">
    <ScrollViewer>
        <StackPanel Padding="28,8,28,28" Spacing="16">
            <TextBlock Text="Sieć" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Karty sieciowe i połączenie" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Adapters}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Test ping" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Własny host lub IP (opcjonalnie)" Text="{x:Bind ViewModel.CustomHost, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Testuj" Command="{x:Bind ViewModel.PingAllCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <Button Grid.Column="2" Content="Przerwij" Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PingRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PingRow">
                                <Grid ColumnSpacing="12" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Summary}" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Serwery DNS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Test mierzy czas odpowiedzi na Twoim łączu. Zmiana DNS wymaga administratora; poprzednie ustawienia są zapisywane i można je przywrócić." Style="{StaticResource MutedTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Testuj serwery DNS" Command="{x:Bind ViewModel.BenchDnsCommand}" Style="{StaticResource AccentButtonStyleX}" />
                        <Button Content="Ustaw najszybszy" Command="{x:Bind ViewModel.UseBestDnsCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Przywróć poprzedni DNS" Command="{x:Bind ViewModel.RestoreDnsCommand}" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.BestDns, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DnsRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DnsRow">
                                <Grid ColumnSpacing="12" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Servers}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Result}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="MTU" Style="{StaticResource SectionTitleStyle}" />
                    <Button Content="Znajdź MTU" Command="{x:Bind ViewModel.FindMtuCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.MtuText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="Dodatkowe, bezpieczne ustawienia sieci (Nagle, ACK, adaptery) znajdziesz w Optymalizacje → Sieć." Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
